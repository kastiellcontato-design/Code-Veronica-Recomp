# Build directories
build/
build-*/
cmake-build-*/
out/
out_jp/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# Compiled objects and libraries
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exp
*.pdb

# Executables
*.exe
*.out
*.app

# Precompiled headers
*.gch
*.pch

# IDE / Editor files
.vs/
.vscode/
*.suo
*.user
*.sln
*.vcxproj*
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
*.egg
.venv/
venv/
env/

# Recompiled output (generated, not tracked)
recompiled/

# Game files (never commit these)
*.elf
*.ELF
*.self
*.SELF
*.bin
*.BIN
*.pkg
*.PKG
*.sfo
*.SFO
*.sprx
*.SPRX

# Decryption keys
*.keys
*.rap

# OS files
.DS_Store
Desktop.ini
Thumbs.db
ehthumbs.db

# Logs
*.log

# Harness batch-run outputs (per-title JSON, work dirs, REPORT.md)
_harness/
.pr_review/
_drill/

# Local Claude Code settings
.claude/

# macOS packaging output
*.dmg

# Gate builds: a port (or the toolkit) built against the toolkit under test,
# kept separate from the developer's own build/ so a gate run cannot be fooled
# by a stale binary. See tools/regress.py.
build-gate/

# Scratch space for generated test drivers and their output (test_ppu_lift.py,
# test_milestone.py).
scratch/

# ---------------------------------------------------------------------------
# Code Veronica port: never publish game data or anything derived from it
# ---------------------------------------------------------------------------
# Game files (the user supplies their own copy)
JOGO/
# Code lifted from the game's executable: regenerate locally with the lifter
src/recomp/
src/recomp_jp/
src/recomp_us/
projects/*/spu/
projects/*/recompiled/
# Shaders dumped from the running game
projects/*/*_dump.hlsl
# Local backups, diagnostics, captures and run logs
backups/
projects/*/codex_diag_*/
projects/*/rsxcap*/
projects/*/run-log-*.txt
projects/*/spu-run-*.txt
*.lnk
*.before-*
# FFmpeg DLLs are fetched separately (see the port's README)
third_party/ffmpeg/bin/
.mcp.json
projects/*/shader_cache/
projects/*/eboot_cache/
projects/*/spu_dump/
*.spufault
projects/*/audio-capture.f32

# Launcher cover art is the title's own artwork: kept local, embedded when present.
projects/*/launcher_art/banner.*
projects/*/launcher_art/icon.*
# Texture mods: dumped and replacement PNGs are the game's images
textures/

# Local Code Veronica saves and diagnostics contain game-derived data.
/Teste Codex save/
projects/*/gamedata/
projects/*/fsr-captures/
projects/*/motion-captures/
projects/code_veronica/vs_*.hlsl
projects/code_veronica/ps_*.hlsl
projects/code_veronica/tools/__pycache__/
# Official redistributable AMD runtime, pinned with license and SHA256.
!third_party/amd_fsr31/bin/amd_fidelityfx_framegeneration_dx12.dll

# Locally derived character textures and executable rollback copies.
projects/*/appearance-assets/*.arc
projects/*/appearance-backups/
projects/*/appearance-assets/humanoids/

/projects/*/save-library-backups/
